{
  "name": "victorstack-ai/drupal-ai-dayone-toolkit",
  "description": "Day-one AI prompt toolkit utilities for Drupal CMS 2.0 content workflows.",
  "type": "drupal-module",
  "license": "MIT",
  "require": {},
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "drupal/coder": "^8.3",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "Drupal\\drupal_ai_dayone_toolkit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Drupal\\Tests\\drupal_ai_dayone_toolkit\\": "tests/src/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "php -l drupal_ai_dayone_toolkit.module src/PromptPack.php src/StarterChecklist.php",
    "phpcs": "phpcs",
    "phpunit": "phpunit"
  }
}
