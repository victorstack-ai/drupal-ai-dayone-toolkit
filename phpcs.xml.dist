<?xml version="1.0"?>
<ruleset name="AI Day One Toolkit">
  <description>PHPCS ruleset for Drupal coding standards.</description>
  <rule ref="Drupal" />
  <rule ref="DrupalPractice" />
  <exclude-pattern>vendor/*</exclude-pattern>
  <file>drupal_ai_dayone_toolkit.module</file>
  <file>src</file>
  <file>tests</file>
</ruleset>
